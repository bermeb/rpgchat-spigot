    <artifactId>RPGChat</artifactId>
    <version>2.5.3</version>

    <properties>
        <!-- Java Configuration.
             Minecraft 26.x runs on Java 25, the 1.19 - 1.21 lines on Java 21. Every
             profile sets java.version itself; a JDK 25 can build all of them, while a
             JDK 21 cannot build the 26.x ones (javac 21 cannot read those class files). -->
        <java.version>25</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Plugin Versions -->
        <build-helper-maven-plugin.version>3.6.1</build-helper-maven-plugin.version>
        <maven-clean-plugin.version>3.5.0</maven-clean-plugin.version>
        <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
        <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
        <exec-maven-plugin.version>3.6.3</exec-maven-plugin.version>
        <specialsource-maven-plugin.version>2.0.5</specialsource-maven-plugin.version>

        <!-- Dependency Versions -->
        <chatcontrol.version>11.8.11</chatcontrol.version>
        <jetbrains.version>26.1.0</jetbrains.version>

        <!-- Default Spigot Configuration (overridden by profiles) -->
        <spigot.version>26.1.2-R0.1-SNAPSHOT</spigot.version>
        <spigot.display.version>26.1.2</spigot.display.version>
        <nms.version>v26_1_R1</nms.version>
        <api.version>1.21</api.version>
        <plugin.author>bermeb</plugin.author>

        <!-- Mapping Configuration.
             Up to 1.21.11 the Spigot server is Spigot-mapped, so those profiles compile
             against the "remapped-mojang" artifact and remap the plugin back to Spigot
             names on package. From 26.1 on Spigot ships Mojang-mapped, so there is neither
             a remapped artifact nor anything to remap: no classifier, and the specialsource
             executions are disabled by binding them to a non-existent phase.

             These defaults track the newest supported version (see above) so that a
             profile-less build stays consistent. Every profile restates them, so changing
             the default line here cannot silently break the others. -->
        <spigot.classifier/>
        <specialsource.phase>none</specialsource.phase>

        <!-- Spigot Version Mappings -->
        <spigot.versions>v1_19_R1,v1_19_R2,v1_19_R3,v1_20_R1,v1_20_R2,v1_20_R3,v1_20_R4,v1_21_R1,v1_21_R2,v1_21_R3,v1_21_R4,v1_21_R5,v1_21_R6,v1_21_R7,v26_1_R1,v26_2_R1</spigot.versions>
    </properties>

